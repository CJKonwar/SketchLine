{
  "name": "sketchline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A text-to-diagram notebook with editable visuals and visitor-supplied Gemini keys.",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "start": "node server/index.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "build:public": "vite build --mode public --outDir dist-public && node scripts/check-public-build.mjs",
    "dev:public": "vite --mode public --host 127.0.0.1",
    "verify:public": "node scripts/check-public-build.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@xyflow/react": "^12.8.6",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": "22.x"
  }
}
